# =============================================================================
# CineVerse - Environment Configuration Template
# (Copy this to .env for local/staging deployments. Never commit real secrets!)
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Authentication & Session Security (Generate high-entropy key via: openssl rand -hex 32)
JWT_SECRET=your_production_grade_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=30d

# MongoDB Database Connection String (MongoDB Atlas or local staging URI)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cineverse_staging?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cineverse

# TMDB Movie Database API Key (v3 auth key)
TMDB_API_KEY=your_tmdb_api_v3_key_here

# Allowed Frontend Origins for CORS (comma-separated for multiple domains)
# Example: https://cineverse-staging.vercel.app,https://cineverse-staging.onrender.com
CLIENT_URL=http://localhost:5173,http://localhost:4173

# Frontend API Base URL (Used by Vite client build if hosted on a separate domain)
# Leave as /api when hosting frontend and backend together on the same host
VITE_API_BASE_URL=/api
