{
  "name": "cineverse-movie-platform",
  "version": "1.0.0",
  "description": "Full-Stack Movie Discovery and Streaming Information Platform using React, Express, MongoDB, and TMDB API",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --watch --watch-path=server server/server.js",
    "server:dev": "node --watch --watch-path=server server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "test": "node run_all_tests.js",
    "test:phase2": "node test_phase2_verification.js",
    "test:phase3": "node test_phase3_verification.js",
    "test:phase4": "node test_phase4_verification.js",
    "test:phase5": "node test_phase5_verification.js",
    "test:phase6": "node test_phase6_verification.js",
    "test:e2e": "node test_e2e_journeys.js",
    "test:security": "node test_stage3_security.js",
    "test:stage4": "node test_stage4_performance_a11y.js",
    "test:a11y": "node test_stage4_performance_a11y.js",
    "test:stage5": "node test_stage5_deployment_readiness.js",
    "test:deploy": "node test_stage5_deployment_readiness.js",
    "test:stage7": "node test_stage7_pipeline_verification.js",
    "test:stage8": "node test_stage8_final_acceptance.js",
    "test:acceptance": "node test_stage8_final_acceptance.js",
    "test:stage10": "node test_stage10_community.js",
    "test:community": "node test_stage10_community.js",
    "test:stage11": "node test_stage11_discovery_watchlist.js",
    "test:watchlist": "node test_stage11_discovery_watchlist.js",
    "test:stage12": "node test_stage12_data_quality_caching.js",
    "test:caching": "node test_stage12_data_quality_caching.js",
    "test:trailers": "node test_trailer_bugfix_verification.js",
    "test:providers": "node test_trailers_where_to_watch.js",
    "test:ci": "node run_all_tests.js",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "react",
    "vite",
    "express",
    "mongodb",
    "mongoose",
    "tmdb",
    "movies",
    "fullstack",
    "streaming",
    "jwt"
  ],
  "author": "Mubashir",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "framer-motion": "^14.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.52.0",
    "mongoose": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.2"
  }
}
